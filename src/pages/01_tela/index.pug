extends ../../templates/page/template.page-base-adaptativo.pug

block styles
	link(rel="stylesheet", href="style.css")
	link(rel="stylesheet", href="../../modules/component.slider.css")


block body
	body
		
		section.sec1
			img.img.wow_right(src="../../assets/img/img1.png", alt="")
			.boxText.wow_left
				h1 Os 7 Princípios da Educação Integral
				p Olá! Nesta seção você vai conhecer e analisar os 7 princípios que fundamentam a Educação Integral.
				p Mais do que conceitos, esses princípios funcionam como critérios orientadores para a formulação de políticas, a organização curricular, a formação docente, as avaliações, desenvolvimento de recursos pedagógicos e, claro, a gestão escolar.

		section.sec2.wow_up
			.boxImg
				.boxText.wow_right
					h2 Objetivos deste momento de aprendizagem
					ul.custom-list
						li Compreender os 7 princípios que estruturam a Educação Integral.
						li Reconhecer a interdependência entre esses princípios e analisar em que medida se expressam nas ações voltadas aos Anos Finais em sua rede.
				img.img.wow_zoomIn.delay1(src="../../assets/img/img2.png", alt="")
		
		section.sec3
			img.img.wow_zoomIn(src="../../assets/img/img3.png", alt="")
			.boxright.wow_left.delay1
				h2 Princípios como orientadores da ação
				p Redes de ensino tomam decisões diariamente sobre currículo, formação, avaliação, gestão, recursos e prioridades.
				p Sem referenciais claros essas decisões podem se tornar fragmentadas, desarticuladas ou até contraditórias.
				p Os princípios aqui apresentados funcionam como critérios orientadores que dão coerência às políticas, às práticas pedagógicas e às estratégias de implementação.

		section.sec4.wow_up
			h2 Os 7 princípios da educação integral
			p Para garantir uma Educação Integral de qualidade, conheça os sete princípios norteadores que orientam políticas, práticas pedagógicas e decisões de gestão, e que orientaram a elaboração da proposta de Educação Integral para os Anos Finais.
			p <span>IMPORTANTE:</span> Os princípios não atuam de forma isolada: são interdependentes e se fortalecem mutuamente, estruturando uma escola comprometida com o desenvolvimento pleno das adolescências.
			p Ao conhecer mais sobre cada princípio, convidamos você a refletir sobre as seguintes questões:
			.flexCards.wow_up
				.card
					p Quais desses princípios estão mais claramente presentes nas políticas e ações voltadas aos Anos Finais?
				.card
					p Há algum princípio que ainda aparece pouco nas diretrizes, formações, recursos pedagógicos ou práticas dessa etapa?
				.card
					p As iniciativas para os Anos Finais contemplam esses princípios de forma articulada ou concentram esforços em apenas um aspecto?
			img.img.wow_right(src="../../assets/img/slide3-list.png", alt="")
			
		section.sec5.wow_up
			h2 Dos princípios à implementação
			p A transição da teoria para a prática exige um método que organize a rede e transforme diretrizes conceituais em caminhos concretos para a rotina escolar.  Aqui, os 7 princípios da Educação Integral orientam a concepção da proposta de Educação Integral para os Anos Finais para que estes deixem de ser apenas referenciais normativos e se traduzam em ações concretas nas redes.
			p <b>Os 7 eixos a seguir dão materialidade aos princípios no planejamento, na gestão e no acompanhamento das ações. Conheça:</b>
			.infoClick
				img(src="../../assets/img/mouse.png", alt="")
				p Clique nos itens para entender os pontos.
			
			.listMod.wow_up
				img.imgFixa(src="../../assets/img/sec5.png", alt="")
				.it.it1(mod=1)
					.contIt
						img(src="../../assets/img/slide-6-it1.png", alt="")
					p Protagonismo do estudante
				.it.it2(mod=2)
					.contIt
						img(src="../../assets/img/slide-6-it2.png", alt="")
					p Desenvolvimento integral
				.it.it3(mod=3)
					.contIt
						img(src="../../assets/img/slide-6-it3.png", alt="")
					p Aprendizagem para todos
				.it.it4(mod=4)
					.contIt
						img(src="../../assets/img/slide-6-it4.png", alt="")
					p Pertencimento, bem-estar e saúde
				.it.it5(mod=5)
					.contIt
						img(src="../../assets/img/slide-6-it5.png", alt="")
					p Equidade, inclusão e diversidade
				.it.it6(mod=6)
					.contIt
						img(src="../../assets/img/slide-6-it6.png", alt="")
					p Ampliação do tempo e dos espaços
				.it.it7(mod=7)
					.contIt
						img(src="../../assets/img/slide-6-it7.png", alt="")
					p Desenvolvimento profissional
				
				.mod.mod1.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Protagonismo do estudante
								p Colocar o(a) estudante no centro das práticas educativas, reconhecendo sua capacidade de participar, opinar, fazer escolhas e construir sentidos para sua aprendizagem e seu projeto de vida. O protagonismo envolve autonomia progressiva, responsabilidade ética e participação ativa na vida escolar.
								.box.boxOrange
									p Nos Anos Finais, fortalecer o protagonismo significa:
									.flex
										.line
										p Criar espaços reais de escuta e participação.
									.flex
										.line
										p Promover metodologias que favoreçam autonomia.
									.flex
										.line
										p Integrar aprendizagem e projeto de vida.
									.flex
										.line
										p Reconhecer os adolescentes como sujeitos do presente — não apenas como sujeitos em preparação para o futuro.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p Os adolescentes participam das decisões que impactam sua vida escolar?
									.flex
										.line
										p Promover metodologias que favoreçam autonomia.
									.flex
										.line
										p Existem instâncias formais de escuta e representação estudantil nos Anos Finais?
									.flex
										.line
										p As práticas pedagógicas favorecem autonomia ou reforçam relações de dependência?
				.mod.mod2.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Desenvolvimento integral
								p Reconhecer que os estudantes são sujeitos multidimensionais e que a escola tem o compromisso de promover oportunidades intencionais para o desenvolvimento cognitivo, físico, emocional, social e cultural.
								p A Educação Integral não se restringe ao desempenho acadêmico, mas articula diferentes dimensões da formação humana.
								.box.boxOrange
									p Nos Anos Finais, fortalecer o desenvolvimento integral significa:
									.flex
										.line
										p Organizar o currículo considerando múltiplas dimensões do desenvolvimento adolescente.
									.flex
										.line
										p Integrar competências cognitivas e socioemocionais.
									.flex
										.line
										p Valorizar experiências culturais, corporais e expressivas.
									.flex
										.line
										p Superar a fragmentação excessiva entre componentes curriculares.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p As propostas para os Anos Finais consideram apenas resultados acadêmicos ou estão fundamentadas em conhecimentos atualizados sobre o desenvolvimento na adolescência?
									.flex
										.line
										p Há articulação intencional entre currículo, convivência, cultura escolar e projeto de vida, de modo a contemplar as múltiplas dimensões do desenvolvimento humano na adolescência?
									.flex
										.line
										p O planejamento pedagógico favorece experiências diversificadas e desafiadoras, alinhadas às características dessa etapa, ou permanece excessivamente centrado na transmissão de conteúdos?
				.mod.mod3.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Aprendizagem para todos
								p Afirmar altas expectativas de aprendizagem para todos os estudantes, reconhecendo que todos são capazes de aprender, ainda que em ritmos e percursos distintos.
								p Esse princípio se concretiza no compromisso as aprendizagens essenciais previstas na BNCC, na adoção de práticas pedagógicas diferenciadas e no acompanhamento sistemático das trajetórias escolares.
								p Aprender não é privilégio de alguns,  é direito de todos.
								.box.boxOrange
									p Nos Anos Finais, fortalecer a aprendizagem significa:
									.flex
										.line
										p Monitorar indicadores de aprendizagem, reprovação, evasão e abandono.
									.flex
										.line
										p Implementar estratégias de recomposição e acompanhamento contínuo.
									.flex
										.line
										p Garantir que as práticas pedagógicas respondam à heterogeneidade das turmas.
									.flex
										.line
										p Sustentar altas expectativas para todos, evitando naturalizar fracassos escolares.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p As políticas e práticas pedagógicas mantêm altas expectativas para todos os estudantes ou há naturalização de baixos desempenhos nos Anos Finais?
									.flex
										.line
										p Existem estratégias estruturadas de acompanhamento das trajetórias escolares e de prevenção da evasão e reprovação?
									.flex
										.line
										p As formações docentes oferecem subsídios para lidar com a heterogeneidade e promover a aprendizagem de todos
				.mod.mod4.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Pertencimento, bem-estar e saúde
								p Promover ambientes escolares física e emocionalmente seguros, acolhedores e inclusivos, que favoreçam o bem-estar de estudantes e educadores.
								p O princípio reconhece que aprendizagem e desenvolvimento estão diretamente relacionados ao sentimento de pertencimento, à qualidade das relações e às condições de saúde física e socioemocional.
								p Sem vínculo, não há aprendizagem consistente.
								.box.boxOrange
									p Nos Anos Finais, fortalecer o pertencimento, bem-estar e saúde significa:
									.flex
										.line
										p Cuidar das transições entre etapas e das mudanças próprias da adolescência.
									.flex
										.line
										p Implementar estratégias de prevenção ao <i>bullying</i>, <i>cyberbullying</i>, racismo, LGBTQIAPN+ fobia,  violência de gênero e exclusão.
									.flex
										.line
										p Estruturar ações de promoção da saúde mental e do clima escolar positivo.
									.flex
										.line
										p Fortalecer vínculos entre estudantes, professores e comunidade.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p As ações voltadas aos Anos Finais contemplam estratégias estruturadas de promoção do bem-estar e da saúde socioemocional?
									.flex
										.line
										p Existem mecanismos sistemáticos de escuta dos estudantes sobre clima escolar e pertencimento?
									.flex
										.line
										p As políticas da rede consideram as especificidades das transições e das mudanças próprias da adolescência?
				.mod.mod5.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Equidade, inclusão e diversidade
								p Reconhecer e enfrentar desigualdades estruturais que atravessam a escola, garantindo acesso, permanência, aprendizagem e conclusão com qualidade para todos os estudantes.
								p Esse princípio implica adotar práticas antirracistas, antissexistas e anticapacitistas, valorizar identidades e promover um ambiente escolar democrático e respeitoso.
								p Não se trata apenas de igualdade de oportunidades, mas de ações intencionais para reduzir desigualdades.
								.box.boxOrange
									p Nos Anos Finais, fortalecer a equidade, inclusão e diversidade significa:
									.flex
										.line
										p Analisar dados desagregados para identificar desigualdades de aprendizagem e permanência.
									.flex
										.line
										p Implementar políticas específicas para grupos historicamente vulnerabilizados.
									.flex
										.line
										p Garantir acessibilidade pedagógica e física.
									.flex
										.line
										p Promover currículo e práticas que valorizem diversidade cultural, étnico-racial e de gênero.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p A rede analisa dados de aprendizagem e permanência considerando recortes de raça, gênero, deficiência e território?
									.flex
										.line
										p Existem políticas e ações específicas para enfrentar desigualdades identificadas nos Anos Finais?
									.flex
										.line
										p As formações e materiais pedagógicos incorporam perspectivas antirracistas, antissexistas e inclusivas de maneira sistemática?
				.mod.mod6.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Ampliação do tempo e dos espaços educativos
								p Ampliar o tempo de permanência na escola e diversificar os espaços educativos como estratégia para fortalecer vínculos, qualificar aprendizagens e ampliar oportunidades formativas.
								p A ampliação do tempo, quando articulada a um projeto pedagógico intencional, pode favorecer o desenvolvimento integral. Não se trata apenas de mais horas, mas de mais possibilidades formativas.
								.box.boxOrange
									p Nos Anos Finais, fortalecer a ampliação do tempo e dos espaços educativos significa:
									.flex
										.line
										p Integrar atividades complementares ao currículo de forma coerente.
									.flex
										.line
										p Utilizar diferentes espaços da escola e do território como ambientes de aprendizagem.
									.flex
										.line
										p Planejar o tempo escolar considerando interesses e características da adolescência.
									.flex
										.line
										p Evitar que a ampliação do tempo resulte apenas na repetição de práticas tradicionais.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p A ampliação do tempo escolar está articulada a um projeto pedagógico intencional ou representa apenas extensão da carga horária?
									.flex
										.line
										p As escolas utilizam o território e diferentes espaços como oportunidades educativas nos Anos Finais?
									.flex
										.line
										p As propostas ampliadas dialogam com os interesses e necessidades dos adolescentes?
				.mod.mod7.in
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Desenvolvimento profissional da equipe pedagógica
								p Investir de forma contínua e intencional na formação de gestores(as) e professores(as), garantindo condições para implementação qualificada do currículo e dos princípios da Educação Integral.
								p O desenvolvimento profissional não se restringe a formações pontuais, mas envolve processos permanentes, contextualizados e articulados às necessidades reais das escolas.
								.box.boxOrange
									p Nos Anos Finais, fortalecer o desenvolvimento profissional da equipe pedagógica significa:
									.flex
										.line
										p Planejar formações alinhadas às especificidades da adolescência e às demandas da etapa.
									.flex
										.line
										p Garantir tempo institucional para estudo, planejamento e colaboração entre pares.
									.flex
										.line
										p Utilizar dados de aprendizagem e indicadores educacionais para orientar a formação.
									.flex
										.line
										p Sustentar acompanhamento formativo e apoio às escolas.
								.box.boxGreen
									p Para refletir: Em sua rede…
									.flex
										.line
										p As ações formativas da rede estão alinhadas aos desafios específicos dos Anos Finais?
									.flex
										.line
										p A formação considera evidências sobre desenvolvimento adolescente e práticas pedagógicas adequadas à etapa?
									.flex
										.line
										p Existem mecanismos de acompanhamento e apoio contínuo às escolas para implementação dos princípios?
			
		section.sec6.wow_up
			h2 Da compreensão à implementação
			p Compreender os princípios da Educação Integral é o primeiro passo. O desafio está em transformá-los em decisões consistentes, práticas sustentáveis e políticas de longo prazo.
			p A força desses princípios não está no documento que os apresenta, mas na forma como orientam escolhas concretas, especialmente nos Anos Finais, etapa estratégica para a permanência, a aprendizagem e o projeto de vida dos estudantes.
			p Implementar uma visão sistêmica exige intencionalidade, monitoramento e compromisso coletivo.
			.flexCards.wow_up
				.card
					p Quais decisões da sua rede precisarão ser revistas à luz desses princípios?
				.card
					p Que ajustes estruturais podem fortalecer sua implementação nos Anos Finais?
				.card
					p Como garantir que esses princípios orientem não apenas discursos, mas ações permanentes?
			img.img.wow_right(src="../../assets/img/img4.png", alt="")

		section.sec7.wow_up
			h2 Dos princípios à implementação
			p  A transição da teoria para a prática exige um método que organize a rede e transforme diretrizes conceituais em caminhos concretos para a rotina escolar.  Aqui, os 7 princípios da Educação Integral orientam a concepção da proposta de Educação Integral para os Anos Finais para que estes deixem de ser apenas referenciais normativos e se traduzam em ações concretas nas redes.
			p <b>Os 5 eixos a seguir dão materialidade aos princípios no planejamento, na gestão e no acompanhamento das ações. Conheça:</b>
			.infoClick
				img(src="../../assets/img/mouse.png", alt="")
				p Clique nos itens para entender os pontos.
			
			.listMod.wow_up
				img.imgFixa(src="../../assets/img/sec5.png", alt="")
				.it.it8(mod=8)
					.contIt
					p Currículo integrado e práticas pedagógicas
				.it.it9(mod=9)
					.contIt
					p Trabalho em rede
				.it.it10(mod=10)
					.contIt
					p Formação continuada de educadores
				.it.it11(mod=11)
					.contIt
					p Gestão descentralizada e da transição entre etapas
				.it.it12(mod=12)
					.contIt
					p Educação antirracista, antissexista e anticapacitista
				
				.mod.mod8.in.blue
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Currículo integrado e práticas pedagógicas
								p Este eixo trata da forma como a rede organiza o currículo e orienta as práticas pedagógicas nos Anos Finais, garantindo coerência com os princípios da Educação Integral.
								p Envolve decisões sobre componentes curriculares, metodologias, integração entre áreas, articulação com projeto de vida e adequação às características da adolescência.
								.infoOrange
									img.ico(src="../../assets/img/icoinfo.png", alt="")
									p No módulo 2 desta jornada de aprendizagem, você realizará uma avaliação diagnóstica estruturada, examinando como esses eixos orientam e se concretizam nas políticas, nas decisões de gestão e nas práticas pedagógicas dos Anos Finais do Ensino Fundamental em sua rede.
				.mod.mod9.in.blue
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Trabalho em rede
								p Este eixo orienta a articulação entre diferentes setores, políticas públicas e atores institucionais para garantir respostas integradas às necessidades dos estudantes nos Anos Finais.
								p Envolve a construção de fluxos de comunicação e cooperação entre educação, saúde, assistência social, cultura e demais serviços do território, fortalecendo a proteção integral e ampliando oportunidades formativas.
								p O trabalho em rede exige coordenação, clareza de responsabilidades e acompanhamento sistemático das ações.
								.infoOrange
									img.ico(src="../../assets/img/icoinfo.png", alt="")
									p No módulo 2 desta jornada de aprendizagem, você realizará uma avaliação diagnóstica estruturada, examinando como esses eixos orientam e se concretizam nas políticas, nas decisões de gestão e nas práticas pedagógicas dos Anos Finais do Ensino Fundamental em sua rede.
				.mod.mod10.in.blue
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Formação continuada de educadores
								p Este eixo orienta a organização de políticas estruturadas de formação continuada para gestores(as) e professores(as), alinhadas aos princípios da Educação Integral e às especificidades dos Anos Finais.
								p Envolve planejamento formativo baseado em evidências, uso de dados educacionais, aprofundamento sobre desenvolvimento na adolescência e apoio às escolas para qualificação das práticas pedagógicas e da gestão.
								p A formação continuada deve ser sistemática, contextualizada e articulada às prioridades da rede.
								.infoOrange
									img.ico(src="../../assets/img/icoinfo.png", alt="")
									p No módulo 2 desta jornada de aprendizagem, você realizará uma avaliação diagnóstica estruturada, examinando como esses eixos orientam e se concretizam nas políticas, nas decisões de gestão e nas práticas pedagógicas dos Anos Finais do Ensino Fundamental em sua rede.
				.mod.mod11.in.blue
					.closeMod
						img.zoomIn.delay2(src="../../assets/img/closeMod.svg", alt="")
					.contentMod
						.contentModBase
							.infMod.up.delay1
								h1 Gestão descentralizada e da transição entre etapas
								p Este eixo orienta a organização de uma gestão que combine coordenação sistêmica da rede com fortalecimento da autonomia das escolas, assegurando coerência na implementação da política de Educação Integral.
								p Inclui a atenção estruturada às transições entre etapas da Educação Básica, especialmente da passagem dos Anos Iniciais para os Anos Finais e destes para o Ensino Médio, garantindo continuidade pedagógica, acolhimento e acompanhamento das trajetórias escolares.
								p A gestão descentralizada requer clareza de responsabilidades, comunicação eficiente e monitoramento contínuo.
								.infoOrange
									img.ico(src="../../assets/img/icoinfo.png", alt="")
									p No módulo 2 desta jornada de aprendizagem, você realizará uma avaliação diagnóstica estruturada, examinando como esses eixos orientam e se concretizam nas políticas, nas decisões de gestão e nas práticas pedagógicas dos Anos Finais do Ensino Fundamental em sua rede.
